# Public site URL. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Long random string. Generate one with: openssl rand -base64 32
PAYLOAD_SECRET=replace-this-with-a-long-random-string

# Postgres connection string (Neon / Vercel Postgres). Without it the site reads src/content/site.json.
# DATABASE_URL=postgres://user:password@host/database?sslmode=require

# Created automatically when you add a Vercel Blob store. Leave unset for local uploads.
# BLOB_READ_WRITE_TOKEN=
