# Public site URL used for metadata. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://homecareconstructions.com

# Strapi origin, without /api. Example: https://cms.example.com
STRAPI_URL=

# Optional read-only API token. Leave empty when the Public role can find content.
STRAPI_API_TOKEN=

# Shared secret for the Strapi webhook that calls /api/revalidate.
REVALIDATE_SECRET=
